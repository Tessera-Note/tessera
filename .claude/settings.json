{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm clean:*)",
      "Bash(pnpm --filter @tessera/web dev:*)",
      "Bash(pnpm --filter @tessera/web build:*)",
      "Bash(pnpm --filter @tessera/web check:*)",
      "Bash(pnpm --filter @tessera/web lint:*)",
      "Bash(pnpm --filter @tessera/web test:*)",
      "Bash(pnpm --filter @tessera/web preview:*)",
      "Bash(pnpm --filter @tessera/editor-ext build:*)",
      "Bash(uv sync:*)",
      "Bash(uv run --project apps/api pytest:*)",
      "Bash(uv run --project apps/api ruff check:*)",
      "Bash(uv run --project apps/api ruff format:*)",
      "Bash(uv run --project apps/api litestar:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run alembic upgrade:*)",
      "Bash(node --test:*)",
      "Bash(node apps/web/scripts/copy-excalidraw-assets.mjs)",
      "Bash(npx prettier --check:*)",
      "Bash(curl -sS --max-time 5 http://localhost:*)",
      "Bash(curl -sS --max-time 5 http://127.0.0.1:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(pkill -f \"vite\")",
      "Bash(docker cp scripts/stand-session.py tessera-v2-api:/tmp/stand-session.py)",
      "Bash(docker exec tessera-v2-api python /tmp/stand-session.py)",
      "Bash(python3 scripts/stand-cookie.py)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(uv publish:*)",
      "Bash(npm version:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker system prune:*)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.local)",
      "Write(.env.local)",
      "Edit(apps/api/.env)",
      "Write(apps/api/.env)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)",
      "Edit(apps/api/uv.lock)",
      "Write(apps/api/uv.lock)",
      "Edit(node_modules/**)",
      "Write(node_modules/**)",
      "Edit(apps/web/build/**)",
      "Write(apps/web/build/**)",
      "Edit(apps/web/.svelte-kit/**)",
      "Write(apps/web/.svelte-kit/**)",
      "Edit(apps/web/static/excalidraw-assets/**)",
      "Write(apps/web/static/excalidraw-assets/**)",
      "Edit(packages/*/dist/**)",
      "Write(packages/*/dist/**)",
      "Edit(apps/api/schema/baseline.sql)",
      "Write(apps/api/schema/baseline.sql)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-status.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  }
}
