# Example environment.
#
# The stand reads `apps/api/.env`, not this file: the set lists the environment
# by name and takes the values from there. This file collects the full set of
# variables with explanations, so that what can be configured is visible.
#
# The order of a first run: docs/deployment-from-scratch.md
# The breakdown by group and the defaults: STACK.md

# --- mandatory ------------------------------------------------------------

# At least 32 characters. The application checks the length at startup.
#   openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

# The database password. It also configures the internal service database
# unless HUB_POSTGRES_PASSWORD is set. DATABASE_URL for the set is assembled
# from it automatically.
POSTGRES_PASSWORD=REPLACE_ME

# The password for the attachment storage.
MINIO_ROOT_PASSWORD=REPLACE_ME

# The shared secret of the internal collaborative editing routes. Latin letters
# and digits only: the value travels in an HTTP header.
#   openssl rand -hex 24
COLLAB_INTERNAL_TOKEN=REPLACE_ME

# --- the application ------------------------------------------------------

# The address the wiki is opened at. The origin of the event channel handshake
# is compared against it as well: a mismatch looks like "the channel refused".
APP_URL=http://localhost:8080

# The port the wiki is opened on outside the set. The proxy stands behind it.
LOCAL_PORT=8080

# The address and port of the application itself inside the set.
HOST=0.0.0.0
PORT=3000

# The number of reverse proxies in front of the application. It decides which
# address counts as the client address: that address goes into the rate
# thresholds and into the audit log. The whole X-Forwarded-For chain cannot be
# trusted — the address is substituted by a header.
TRUST_PROXY_HOPS=1

DEBUG_MODE=false
DISABLE_TELEMETRY=false

# --- database and queues --------------------------------------------------

# For running without the set. Inside the set these are assembled from
# POSTGRES_PASSWORD and the service name.
# DATABASE_URL=postgresql://tessera:PASSWORD@127.0.0.1:5432/tessera
# REDIS_URL=redis://127.0.0.1:6379

# --- attachment storage ---------------------------------------------------

# local or s3. The set runs MinIO, which means s3.
STORAGE_DRIVER=s3

# Without this path the application takes the deployment path, which does not
# exist on a developer machine, and a file upload answers with a 500 and no log
# record.
# STORAGE_LOCAL_PATH=/app/data/storage

MINIO_ROOT_USER=tessera
MINIO_BUCKET=tessera
MINIO_REGION=us-east-1

AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=true

FILE_UPLOAD_SIZE_LIMIT=50mb
FILE_IMPORT_SIZE_LIMIT=200mb

# --- mail -----------------------------------------------------------------

# log writes the letter into the log and does not reach outside. smtp sends to
# the real recipient.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Tessera

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- companion services ---------------------------------------------------

# The application address for the server loaders of the screens. It never
# reaches the browser.
API_INTERNAL_URL=http://tessera-v2-api:3000

# Public values; these do reach the browser.
PUBLIC_API_URL=
PUBLIC_DRAWIO_URL=http://localhost:8081

# The content conversion and collaborative editing service.
CONTENT_SERVICE_URL=http://tessera-v2-collab:3001

# The internal service for versions, telemetry, documentation and the license.
HUB_INTERNAL_URL=http://tessera-v2-hub:4000
HUB_URL=http://localhost:4000
HUB_POSTGRES_PASSWORD=

# PDF rendering. The service name in PDF_RENDER_BASE_URL is also hard-wired
# into --chromium-allow-list for Gotenberg: renaming it breaks the export
# silently.
GOTENBERG_URL=http://tessera-v2-gotenberg:3000
PDF_RENDER_BASE_URL=http://tessera-v2-web:3000
PDF_EXPORT_TIMEOUT=60000

# What the Gotenberg browser is allowed to load. The default admits it only to
# the render page, the build of the screens, the files and the dictionaries.
# Narrowing it breaks the export silently: the page arrives with no styles or
# no images.
PDF_ALLOW_LIST=

# The form signing key of the SearXNG interface of its own. It does not affect
# search: the settings file is mounted read-only and the substitution does not
# go through.
SEARXNG_SECRET=

# --- the assistant --------------------------------------------------------

# The only call the set makes outside, apart from external SMTP. While
# AI_DRIVER is not set, the assistant is off entirely.
AI_DRIVER=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_COMPLETION_MODEL=
AI_EMBEDDING_MODEL=

# The keys can also be set through the interface: there they are stored in the
# database encrypted (AES-256-GCM from APP_SECRET), and only a masked preview
# is served outward.
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_URL=

# --- signing in through a provider ----------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
