# Пример окружения второй версии.
#
# Стенд читает `apps/api/.env`, а не этот файл: состав перечисляет окружение
# поимённо и берёт значения оттуда. Здесь собран полный состав переменных с
# пояснениями, чтобы было видно, что вообще настраивается.
#
# Порядок первого запуска: docs/deployment-from-scratch.md
# Разбор по группам и умолчания: STACK.md

# --- обязательные ---------------------------------------------------------

# Не короче 32 знаков. Приложение проверяет длину на старте.
#   openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

# Пароль базы. Им же настраивается база внутреннего сервиса, если не задан
# HUB_POSTGRES_PASSWORD. DATABASE_URL для состава собирается из него сам.
POSTGRES_PASSWORD=REPLACE_ME

# Пароль хранилища вложений.
MINIO_ROOT_PASSWORD=REPLACE_ME

# Общий секрет внутренних маршрутов совместного редактирования. Только латиница
# и цифры: значение уходит заголовком HTTP.
#   openssl rand -hex 24
COLLAB_INTERNAL_TOKEN=REPLACE_ME

# --- приложение -----------------------------------------------------------

# Адрес, по которому вика открывается. С ним же сверяется происхождение при
# рукопожатии канала событий: расхождение выглядит как «канал отказал».
APP_URL=http://localhost:8080

# Порт, на котором вика открывается снаружи состава. За ним стоит прокси.
LOCAL_PORT=8080

# Адрес и порт самого приложения внутри состава.
HOST=0.0.0.0
PORT=3000

# Число обратных прокси перед приложением. От него зависит, какой адрес
# считается адресом клиента: он идёт в пороги частоты и в журнал аудита.
# Доверять всей цепочке X-Forwarded-For нельзя — адрес подставляется заголовком.
TRUST_PROXY_HOPS=1

DEBUG_MODE=false
DISABLE_TELEMETRY=false

# --- база и очереди -------------------------------------------------------

# Для запуска без состава. Внутри состава собирается из POSTGRES_PASSWORD и
# имени службы.
# DATABASE_URL=postgresql://tessera:ПАРОЛЬ@127.0.0.1:5432/tessera
# REDIS_URL=redis://127.0.0.1:6379

# --- хранилище вложений ---------------------------------------------------

# local либо s3. В составе поднят MinIO, то есть s3.
STORAGE_DRIVER=s3

# Без этого пути приложение берёт путь развёртывания, которого на машине
# разработчика нет, и загрузка файла отвечает 500 без записи в журнал.
# STORAGE_LOCAL_PATH=/app/data/storage

MINIO_ROOT_USER=tessera
MINIO_BUCKET=tessera
MINIO_REGION=us-east-1

AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=true

FILE_UPLOAD_SIZE_LIMIT=50mb
FILE_IMPORT_SIZE_LIMIT=200mb

# --- почта ----------------------------------------------------------------

# log пишет письмо в журнал и наружу не ходит. smtp отправляет настоящему
# адресату.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Tessera

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- соседние службы ------------------------------------------------------

# Адрес приложения для серверных загрузчиков экранов. В браузер не попадает.
API_INTERNAL_URL=http://tessera-v2-api:3000

# Публичные значения, попадают в браузер.
PUBLIC_API_URL=
PUBLIC_DRAWIO_URL=http://localhost:8081

# Служба преобразования содержимого и совместного редактирования.
CONTENT_SERVICE_URL=http://tessera-v2-collab:3001

# Внутренний сервис версий, телеметрии, документации и лицензии.
HUB_INTERNAL_URL=http://tessera-v2-hub:4000
HUB_URL=http://localhost:4000
HUB_POSTGRES_PASSWORD=

# Отрисовка PDF. Имя службы в PDF_RENDER_BASE_URL зашито и в
# --chromium-allow-list у Gotenberg: переименование ломает выгрузку молча.
GOTENBERG_URL=http://tessera-v2-gotenberg:3000
PDF_RENDER_BASE_URL=http://tessera-v2-web:3000
PDF_EXPORT_TIMEOUT=60000

# Что браузеру Gotenberg разрешено загружать. Умолчание пускает его только к
# странице отрисовки, сборке экранов, файлам и словарям. Сужение ломает
# выгрузку молча: страница приезжает без стилей или без картинок.
PDF_ALLOW_LIST=

# Ключ подписи форм собственного интерфейса SearXNG. На работу поиска не
# влияет: файл настроек смонтирован только на чтение, и подстановка не проходит.
SEARXNG_SECRET=

# --- помощник -------------------------------------------------------------

# Единственное обращение состава наружу, кроме внешнего SMTP. Пока AI_DRIVER не
# задан, помощник выключен целиком.
AI_DRIVER=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_COMPLETION_MODEL=
AI_EMBEDDING_MODEL=

# Ключи можно задать и через интерфейс: там они хранятся в базе шифрованными
# (AES-256-GCM от APP_SECRET), а наружу отдаётся только маскированный превью.
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_URL=

# --- вход через провайдера ------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
