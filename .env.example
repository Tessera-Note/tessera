# your domain, e.g https://example.com
APP_URL=http://localhost:3000
PORT=3000

# minimum of 32 characters. Generate one with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

JWT_TOKEN_EXPIRES_IN=30d

# ВАЖНО: при запуске через docker compose эта строка НЕ используется.
# Compose собирает DATABASE_URL сам из POSTGRES_PASSWORD и имени сервиса
# (см. docker-compose.yml), поэтому менять её для docker не нужно вовсе.
#
# Значение ниже нужно только для запуска без docker и для команд с машины
# разработчика (миграции, кодогенерация). Имена хостов там это имена сервисов
# compose, а пользователь и база создаются контейнером как `tessera`.
DATABASE_URL="postgresql://tessera:password@tessera-db:5432/tessera?schema=public"
REDIS_URL=redis://tessera-redis:6379

# Для запуска без docker, когда база и Redis подняты на самой машине:
# DATABASE_URL="postgresql://tessera:password@localhost:5432/tessera?schema=public"
# REDIS_URL=redis://127.0.0.1:6379

# Password for the postgres container in docker-compose.yml.
# The app never reads it: it configures the database container itself, and
# HUB_POSTGRES_PASSWORD falls back to it.
# Leaving it unset does not stop compose. It substitutes a blank password and
# the database container comes up misconfigured, which surfaces later as a
# connection failure. deploy/docker-compose.vps.yml does abort without it.
# Пароль базы. Обязателен: compose подставляет пустое значение, если его нет,
# и контейнер базы поднимается настроенным неверно.
# DATABASE_URL для docker собирается из него автоматически, править её не надо.
POSTGRES_PASSWORD=password

# options: local | s3 | azure
STORAGE_DRIVER=local

# S3 driver config
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# Azure Blob Storage driver config
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=

# default: 50mb
FILE_UPLOAD_SIZE_LIMIT=

# options: smtp | postmark
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Gobrax Wiki

# SMTP driver config
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Postmark driver config
POSTMARK_TOKEN=

# Редактор диаграмм. В compose поднимается сервис tessera-drawio,
# наружу за embed.diagrams.net приложение не ходит.
DRAWIO_URL=http://localhost:8081

# Внутренний сервис tessera-hub: версии, телеметрия, документация,
# лицензия и страница поддержки.
# HUB_INTERNAL_URL - адрес внутри сети compose, им пользуется сервер.
# HUB_URL - адрес для браузера, на него ведут ссылки в интерфейсе.
HUB_INTERNAL_URL=http://tessera-hub:4000
HUB_URL=http://localhost:4000
HUB_SUPPORT_EMAIL=support@tessera.local
HUB_SEED_RELEASE_VERSION=0.95.0
HUB_POSTGRES_PASSWORD=

# Хранилище вложений. В compose поднимается tessera-minio, совместимый с S3.
MINIO_ROOT_USER=tessera
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=tessera
MINIO_REGION=us-east-1

# Gotenberg URL for server-side PDF export. Without it, PDF export is disabled.
# With the bundled compose file: http://gotenberg:3000
GOTENBERG_URL=

# Origin Gotenberg loads the render page from, resolved inside the Docker
# network. Defaults to http://tessera:<PORT>, the service name in the compose
# files — not APP_URL, which would require public DNS and TLS to work from
# inside the container.
PDF_RENDER_BASE_URL=

# Milliseconds allowed for one PDF render (default: 60000)
PDF_EXPORT_TIMEOUT=

# Телеметрия уходит во внутренний tessera-hub, наружу ничего не отправляется.
DISABLE_TELEMETRY=false

# Allow other sites to embed Tessera in an iframe.
IFRAME_EMBED_ALLOWED=false

# Only used when IFRAME_EMBED_ALLOWED=true. When empty, any origin is allowed.
# Example: https://intranet.example.com,https://portal.example.com
IFRAME_ALLOWED_ORIGINS=

# Enable debug logging in production (default: false)
DEBUG_MODE=false

# Log database queries
DEBUG_DB=false

# Log http requests
LOG_HTTP=false

# Do not send RequestedAuthnContext in the SAML AuthnRequest.
# Some identity providers reject the request when it is present (default: false)
SAML_DISABLE_REQUESTED_AUTHN_CONTEXT=false

# OAuth client for "Sign in with Google". One client per installation:
# the redirect URI registered in Google Cloud Console must be
# <APP_URL>/api/sso/google/callback and cannot carry a workspace subdomain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emergency password login while SSO is enforced.
# Restores password login for the owner and workspace admins only, so that a
# broken identity provider cannot lock everyone out. Every admitted attempt is
# written to the audit log, and the server warns on every start while it is on.
# There is no time limit: remove the variable once the provider is fixed.
SSO_EMERGENCY_PASSWORD_LOGIN=false

# Число обратных прокси перед приложением. По умолчанию 1.
# От него зависит, какой адрес считается адресом клиента: он идет в пороги
# частоты запросов и в журнал аудита. Значение «доверять всей цепочке»
# намеренно недоступно, оно позволяет подставить адрес заголовком.
# ВНИМАНИЕ: docker-compose.yml эту переменную сейчас в контейнер не передает,
# см. docs/deployment-from-scratch.md.
TRUST_PROXY_HOPS=1
