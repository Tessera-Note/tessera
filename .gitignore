.env
.env.*
!.env.example

# The stand session token: credentials, see scripts/stand-session.py
.stand-session
data

# Secrets and keys are never put into the index under any name.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
# The Excalidraw fonts are placed into the static directory by the
# `@tessera/web` build (apps/web/scripts/copy-excalidraw-assets.mjs). They have
# no business being in the index.
apps/web/static/excalidraw-assets/

# compiled output
dist
# Vite also writes its output under other names when the build is run with a
# different outDir: the `dist` rule does not cover those directories.
dist-*/
tsconfig.tsbuildinfo
# With no trailing slash and no anchor: pnpm creates node_modules in every
# package, while `/node_modules` covered only the root one.
node_modules/
/.worktrees

# Python, services/hub
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
coverage
/.nyc_output

# Database backups. `deploy/backup-db.sh` writes the dump into
# <DEPLOY_PATH>/backups, and with DEPLOY_PATH inside the checkout it would end
# up in the working tree.
backups/
*.sql.gz
*.dump

__temp__/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.nx
.nx/installation
.nx/cache

# Claude Code
# settings.json is committed, it is the shared configuration of the team
# settings.local.json and the logs are local
.claude/logs/
.claude/settings.local.json
.claude/*.local.json
.claude/*.local.*

# Working copies for comparing versions side by side: two instances under one
# root.
/temp/
