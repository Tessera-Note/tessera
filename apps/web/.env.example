# Адрес API для браузера. Пустое значение означает тот же источник, что и
# страница: обратный прокси отдаёт и страницу, и `/api`. Сервер разработки
# проксирует `/api` сам, поэтому и там значение пустое.
PUBLIC_API_URL=

# Адрес API для отрисовки на сервере. Пустым быть не может: пустой означает
# запрос сервера к самому себе, а на `/api` он не отвечает — получается
# рекурсия до исчерпания памяти.
API_INTERNAL_URL=http://127.0.0.1:3100

# Адрес редактора диаграмм. Свой сервис рядом в развёртывании: экземпляр
# работает без обращений в интернет. За обратным прокси он открыт по пути
# `/drawio/`, и это же значение стоит умолчанием.
PUBLIC_DRAWIO_URL=/drawio/
